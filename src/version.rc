#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     LLP_V1,LLP_V2,LLP_V3,0
 PRODUCTVERSION  LLP_V1,LLP_V2,LLP_V3,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "FH2 livery layer limit patch (FH2 Mod Platform mod)"
            VALUE "FileVersion",      LLP_VERSION_STR
            VALUE "InternalName",     "LiveryLayerPatch"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "LiveryLayerPatch.dll"
            VALUE "ProductName",      "LiveryLayerPatch"
            VALUE "ProductVersion",   LLP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
